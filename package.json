    "verify:llm": "npm run build:verify --silent && node scripts/verify-llm.mjs",
    "verify:memos": "npm run build:verify --silent && node scripts/verify-memos.mjs",
    "verify:reminders": "npm run build:verify --silent && node scripts/verify-reminders.mjs",
    "verify:search": "npm run build:verify --silent && node scripts/verify-search.mjs",
    "verify:weather": "npm run build:verify --silent && node scripts/verify-weather.mjs",
    "verify:web": "npm run build:verify --silent && node scripts/verify-web-reader.mjs",
    "verify:mp": "node scripts/verify-mp.mjs",
    "verify:wecom": "node scripts/verify-wecom.mjs",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
